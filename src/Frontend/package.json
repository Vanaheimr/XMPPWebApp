{
  "name": "xmppwebapp-frontend",
  "version": "0.1.0",
  "description": "Frontend of the Vanaheimr XMPPWebApp: an XMPP chat client as a web page - HTML, SCSS and TypeScript bundled by webpack, served by the Hermod HTTP/1.1 server.",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "devDependencies": {
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "sass": "^1.108.1",
    "sass-loader": "^17.1.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1"
  }
}
