<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      What is checked here is the web app and nothing else: the protocol has
      its own suite in Ratatoskr, the HTTP server its own in Hermod. What this
      application decides for itself - who may use the page, what a chat keeps
      and in which order, what a browser may type and an XML stream may not
      carry, which endpoint it will open - is what is checked here.
    -->
    <RootNamespace>org.GraphDefined.Vanaheimr.XMPPWebApp.Tests</RootNamespace>
    <AssemblyName>org.GraphDefined.Vanaheimr.XMPPWebApp.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The frontend is not needed to test the backend, and a test run of this
      project on its own should not start npm.

      Only on its own, though. A solution that holds this project holds
      XMPPWebApp too and builds it with its frontend anyway; asking for it once
      more with SkipFrontendBuild made a second project instance of it with
      the same output path, and after a clean the two wrote XMPPWebApp.dll at
      the same time. Inside a solution the reference is therefore the plain one
      and resolves to the instance the solution builds.
    -->
    <ProjectReference Include="..\XMPPWebApp\XMPPWebApp.csproj" Condition="'$(SolutionPath)' == '' Or '$(SolutionPath)' == '*Undefined*'" AdditionalProperties="SkipFrontendBuild=true" />
    <ProjectReference Include="..\XMPPWebApp\XMPPWebApp.csproj" Condition="'$(SolutionPath)' != '' And '$(SolutionPath)' != '*Undefined*'" />
  </ItemGroup>

</Project>
