<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      What is checked here is the web app and nothing else: the protocol has
      its own suite in Ratatoskr, the HTTP server its own in Hermod. What this
      application decides for itself - who may use the page, what a chat keeps
      and in which order, what a browser may type and an XML stream may not
      carry, which endpoint it will open - is what is checked here.
    -->
    <RootNamespace>org.GraphDefined.Vanaheimr.XMPPWebApp.Tests</RootNamespace>
    <AssemblyName>org.GraphDefined.Vanaheimr.XMPPWebApp.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The frontend is not needed to test the backend, and a test run should not start npm. -->
    <ProjectReference Include="..\XMPPWebApp\XMPPWebApp.csproj" AdditionalProperties="SkipFrontendBuild=true" />
  </ItemGroup>

</Project>
